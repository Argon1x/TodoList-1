<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TodoListApp.MainWindow"
        Title="Todo List"
        Width="760" Height="480">
    <Grid ColumnDefinitions="300,*" Margin="10">

        <ListBox Name="TasksListBox"
                 Grid.Column="0"
                 Margin="0,0,10,0"
                 SelectionChanged="TasksListBox_OnSelectionChanged" />

        <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="Название:" />
            <TextBox Name="TitleTextBox" />

            <TextBlock Text="Описание:" />
            <TextBox Name="DescriptionTextBox" AcceptsReturn="True" Height="60" />

            <TextBlock Text="Дата создания:" />
            <TextBlock Name="CreatedAtTextBlock" FontStyle="Italic" Text="(появится после выбора задачи в списке)" />

            <TextBlock Text="Срок выполнения:" />
            <DatePicker Name="DueDatePicker" />

            <TextBlock Text="Приоритет:" />
            <ComboBox Name="PriorityComboBox" HorizontalAlignment="Stretch" />

            <TextBlock Text="Статус:" />
            <ComboBox Name="StatusComboBox" HorizontalAlignment="Stretch" />

            <TextBlock Name="ErrorTextBlock" Foreground="Red" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <Button Content="Добавить" Click="AddButton_OnClick" />
                <Button Content="Сохранить изменения" Click="EditButton_OnClick" />
                <Button Content="Удалить" Click="DeleteButton_OnClick" />
                <Button Content="Очистить форму" Click="ClearButton_OnClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
